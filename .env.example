# The port the server listens on. Coolify sets this for the app.
PORT=
# The PostgreSQL connection string. When this is empty, the server keeps data in memory only, which is fine for trying it out on your own computer but loses everything on restart.
DATABASE_URL=
# The founder key. Only a request carrying this key in the x-admin-key header can create a shop. Set a long random value in Coolify. Never put a real key in this example file.
ADMIN_KEY=
